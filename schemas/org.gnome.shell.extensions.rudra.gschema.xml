<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.rudra"
          path="/org/gnome/shell/extensions/rudra/">

    <key name="toggle-launcher" type="as">
      <default>['&lt;Control&gt;&lt;Shift&gt;space']</default>
      <summary>Toggle Rudra</summary>
    </key>

    <key name="corner-radius" type="i">
      <default>20</default>
      <summary>Corner radius</summary>
    </key>

    <key name="font-name" type="s">
      <default>'Sans 12'</default>
      <summary>Font family and size</summary>
    </key>

    <key name="max-results" type="i">
      <default>10</default>
    </key>

    <key name="visible-results" type="i">
      <default>5</default>
    </key>

    <key name="result-spacing" type="i">
      <default>4</default>
    </key>

    <key name="enable-fuzzy-search" type="b">
      <default>true</default>
      <summary>Enable fuzzy search</summary>
    </key>

    <key name="launcher-width" type="i">
      <range min="400" max="1200"/>
      <default>900</default>
      <summary>Total width of the launcher</summary>
    </key>

    <key name="ai-provider" type="i">
        <default>0</default>
        <summary>AI Provider</summary>
        <description>0 = Gemini, 1 = Groq, 2 = Ollama, 3 = Perplexity, 4 = Cohere</description>
    </key>

    <key name="ai-api-key-gemini" type="s"><default>""</default></key>
    <key name="ai-api-key-groq" type="s"><default>""</default></key>
    <key name="ai-api-key-perplexity" type="s"><default>""</default></key>
    <key name="ai-api-key-cohere" type="s"><default>""</default></key>

    <key name="search-history" type="as"><default>[]</default></key>
    <key name="ai-chat-history" type="as"><default>[]</default></key>
    
    <key name="clipboard-history-size" type="i"><default>50</default></key>

    <key name="trigger-ai" type="s"><default>'?'</default></key>
    <key name="trigger-clipboard" type="s"><default>'cb'</default></key>
    <key name="trigger-plugin" type="s"><default>'p'</default></key>
    <key name="trigger-icon" type="s"><default>'ic'</default></key>
    <key name="trigger-emoji" type="s"><default>'em'</default></key>
    <key name="trigger-google" type="s"><default>'g'</default></key>
    <key name="trigger-youtube" type="s"><default>'yt'</default></key>
    <key name="trigger-ddg" type="s"><default>'ddg'</default></key>
    <key name="trigger-wiki" type="s"><default>'w'</default></key>
    <key name="trigger-perplexity" type="s"><default>'px'</default></key>
    <key name="trigger-cohere" type="s"><default>'co'</default></key>

  </schema>
</schemalist>